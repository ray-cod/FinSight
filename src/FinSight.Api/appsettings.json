{
  "Database": {
    "ConnectionString": ""
  },

  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "FinSight:"
  },

  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "finsight",
    "Password": "finsight",
    "VirtualHost": "/",
    "ConnectionName": "finsight-api"
  },

  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext"]
  },

  "Telemetry": {
    "ServiceName": "FinSight.Api",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": "http://localhost:4317"
  },

  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": ["https://app.finsight.example"]
  }
}
